{
  "name": "retrysafe",
  "version": "0.1.1",
  "description": "Find webhook and queue handlers that double-charge, double-email, or drop events when a retry arrives.",
  "keywords": [
    "idempotency",
    "webhooks",
    "static-analysis",
    "retries",
    "stripe",
    "bullmq",
    "typescript",
    "lint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammy440/retrysafe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sammy440/retrysafe#readme",
  "bugs": "https://github.com/sammy440/retrysafe/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "retrysafe": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json && node scripts/write-dts.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "picomatch": "^4.0.7",
    "ts-morph": "^28.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@retrysafe/core": "workspace:^",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.2"
  }
}
